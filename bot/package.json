{
  "name": "flashloan-bot-engine",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "test": "node --test",
    "hermes:mcp": "node --experimental-strip-types src/hermes-mcp.ts",
    "hermes:rpc": "source ../scripts/alchemy-rpc-env.sh && node src/hermes-rpc-bridge.mjs",
    "hermes:control": "node src/hermes-control-server.mjs",
    "hermes:run": "source ../scripts/alchemy-rpc-env.sh && node src/hermes-agentic-run.mjs",
    "hermes:live": "node src/hermes-live-gateway.mjs",
    "hermes:live:test": "node --test src/live-execution-pipeline.test.ts",
    "hermes:live-run": "source ../scripts/alchemy-rpc-env.sh && node src/hermes-live-run.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}

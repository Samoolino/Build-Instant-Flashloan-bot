# Copy to .env only for local development; never commit .env.
# The value below is intentionally a placeholder.
ALCHEMY_API_KEY=replace_with_your_alchemy_key

# Complete URLs are generated from ALCHEMY_API_KEY by scripts/alchemy-rpc-env.sh.
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/replace_with_your_alchemy_key
BSC_RPC_URL=https://bnb-mainnet.g.alchemy.com/v2/replace_with_your_alchemy_key
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/replace_with_your_alchemy_key
ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/replace_with_your_alchemy_key
AVAX_RPC_URL=https://avax-mainnet.g.alchemy.com/v2/replace_with_your_alchemy_key
CRONOS_RPC_URL=https://cronos-mainnet.g.alchemy.com/v2/replace_with_your_alchemy_key
SONIC_RPC_URL=https://sonic-mainnet.g.alchemy.com/v2/replace_with_your_alchemy_key

# Hermes execution policy.
MIN_NET_PROFIT_USD=2
TARGET_PROFIT_USD=200

# Never place a private key in this file or in Git.
# Configure an external signer through your secret manager instead.
HERMES_LIVE_EXECUTION=0
HERMES_BROADCAST=0
HERMES_EXTERNAL_SIGNER_URL=
HERMES_EXTERNAL_SIGNER_TOKEN=
HERMES_BROADCAST_RPC_URL=
